# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are compiled into the app.

# Base URL of the backend API, with the /api suffix. Unset in development it
# defaults to the dev server on this machine (10.0.2.2 on the Android emulator).
EXPO_PUBLIC_API_URL=https://your-api.example.com/api

# Website address, used for "open on the website" links (e.g. checkout for now).
EXPO_PUBLIC_WEB_URL=https://your-site.example.com

# Google sign-in. The WEB client id is the same one as GOOGLE_CLIENT_ID on the
# server and VITE_GOOGLE_CLIENT_ID on the website: the native SDK asks Google for
# an ID token for that audience. The iOS client id is a separate "iOS" OAuth
# client in the same Google Cloud project; add it to GOOGLE_EXTRA_CLIENT_IDS on
# the server. Android needs an "Android" OAuth client (package com.chayabari.app
# + the signing SHA-1) to exist in the project, but no id here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
