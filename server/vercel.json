{
  "version": 2,
  "regions": ["hnd1"],
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
