# Server configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Local dev example: postgresql://USER:PASSWORD@localhost:5432/chaya_bari?schema=public
# Supabase: copy the "Connection string" (URI) from Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaya_bari?schema=public

# Auth
# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In: the ONLY way to sign in (customers and staff). Create an OAuth
# "Web application" client in Google Cloud Console, add your site origins (and
# http://localhost:5173 for local dev) as Authorized JavaScript origins, and use
# the same client ID here and in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Seeded staff accounts (npm run seed): the Google account emails of the owner
# (admin) and the kitchen. They sign in with Google; there are no passwords.
SEED_ADMIN_EMAIL=
SEED_KITCHEN_EMAIL=

# Web Push (VAPID). Generate a keypair with `npx web-push generate-vapid-keys`
# and paste them here. Leave BLANK to disable push (the app still works; the
# in-app bell keeps working and the "Enable notifications" control is hidden).
# VAPID_SUBJECT must be a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@chayabari.example

# Outgoing email (SMTP). Leave SMTP_HOST blank to run in log-only mode.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>,
# SMTP_PASS=<Google App Password>, and MAIL_FROM must use that same address
# or mail fails authentication and lands in spam.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ছায়া বাড়ি <you@gmail.com>
# Optional: where replies go (defaults to the MAIL_FROM address).
MAIL_REPLY_TO=
