# Server configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Local dev example: postgresql://USER:PASSWORD@localhost:5432/chaya_bari?schema=public
# Supabase: copy the "Connection string" (URI) from Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaya_bari?schema=public

# Auth
# Generate a long random string for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Web Push (VAPID). Generate a keypair with `npx web-push generate-vapid-keys`
# and paste them here. Leave BLANK to disable push (the app still works; the
# in-app bell keeps working and the "Enable notifications" control is hidden).
# VAPID_SUBJECT must be a mailto: or https: contact URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@chayabari.example

# bKash Tokenized Checkout (PGW). Leave BLANK to run in sandbox/mock mode —
# the "Pay with bKash" flow works end to end and settles instantly for testing.
# Fill all five with your merchant credentials to switch to LIVE payments.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
