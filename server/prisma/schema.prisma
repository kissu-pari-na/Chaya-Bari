// Chaya Bari — homemade food business management system.
// Modular monolith: this single schema grows module-by-module across phases.
// Phase 1 (Foundation) covers authentication, roles, and the customer profile.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application role. Kept separate from business ownership — access is role-based.
enum Role {
  CUSTOMER
  ADMIN
  KITCHEN
}

/// An authenticated user of the system.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Account confirmation. Sign-in is Google only, so an account is confirmed
  // (emailVerifiedAt) the first time its owner signs in with Google.
  // phoneVerifiedAt and passwordHash are legacy columns kept for old rows.
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?

  /// A customer account an admin opened on someone's behalf (by email) to place
  /// orders for them. It has no usable password and no one has proven they own
  /// the email yet. Whoever later registers / signs in with Google / resets the
  /// password for that email and confirms it takes the account over — with all
  /// its orders, addresses and history — and this flag is cleared.
  isPlaceholder Boolean @default(false)

  // Footprint: which admin created this account (null for self-registered
  // customers and the seeded owners).
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")
  /// Orders this (admin) user placed on a customer's behalf.
  placedOrders Order[] @relation("OrderPlacedBy")

  // A user with the CUSTOMER role has a linked customer profile.
  customer          Customer?
  notifications     Notification[]
  verificationCodes VerificationCode[]
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([createdById])
}

/// Which contact channel a confirmation code targets.
enum VerificationChannel {
  PHONE
  EMAIL
  PASSWORD_RESET
}

/// A one-time confirmation code sent to a user's phone or email. The code is
/// stored hashed; it expires and has an attempt cap.
model VerificationCode {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([userId, channel])
}

/// Fixed-window rate-limit counter, keyed by an opaque bucket string (e.g.
/// "email-code:foo@bar.com" or "auth-ip:1.2.3.4"). Persisted so limits hold
/// across serverless invocations. `expiresAt` marks the end of the current
/// window; once passed, the counter resets on next use.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// (Review model is defined in Phase 12 near the bottom of this schema.)

/// Customer profile (1-1 with a User). Holds ordering-related info and, later,
/// derived analytics.
model Customer {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  walletEntries WalletEntry[]
  walletGrants  WalletLimitGrant[]
}

// -----------------------------------------------------------------------------
// Phase 2 — Products
// -----------------------------------------------------------------------------

/// Grouping for products (e.g. Rice Dishes, Desserts, Snacks).
model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// A sellable item. `isActive` controls whether it exists in the catalog at all;
/// `isAvailable` controls whether it can currently be ordered (e.g. sold out
/// today). Image is stored as a URL so it stays configurable without code
/// changes; real uploads can be added later.
model Product {
  id          String           @id @default(cuid())
  name        String
  /// Optional English name shown when the app language is English; falls back
  /// to `name` when empty. Mirrors the business moto's bilingual pattern.
  nameEnglish String?
  description String?
  imageUrl    String?
  /// Current selling price. Historical orders keep their own captured price.
  price       Decimal          @db.Decimal(10, 2)
  /// Optional promotional price. When set below `price`, the item sells at this
  /// price and the difference is recorded as a product discount on the order.
  salePrice   Decimal?         @db.Decimal(10, 2)
  isActive    Boolean          @default(true)
  isAvailable Boolean          @default(true)
  prepInfo    String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  priceHistory ProductPriceHistory[]
  orderItems   OrderItem[]
  recipe       Recipe?
  reviews      Review[]

  @@index([categoryId])
  @@index([isActive, isAvailable])
}

/// Append-only log of a product's selling price over time. Supports "different
/// prices over time" without mutating past records.
model ProductPriceHistory {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())

  @@index([productId])
}

// -----------------------------------------------------------------------------
// Phase 3 — Customer ordering
// -----------------------------------------------------------------------------

enum OrderStatus {
  /// Placed; waiting for payment (pay first) or admin confirmation.
  PENDING
  CONFIRMED
  /// In the kitchen. Order.readyAt marks "packed & ready to dispatch".
  PREPARING
  /// On the way to the customer.
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  /// Not paid yet (pay first awaiting payment, or COD before delivery).
  PENDING
  /// Fully settled.
  PAID
  PARTIALLY_PAID
  /// A charge was reversed (order cancelled); any money paid stays as wallet credit.
  REFUNDED
  FAILED
  /// Charged to the customer's wallet (pay later, or COD collected short).
  ON_WALLET
}

/// How the customer settles an order. PREPAID orders pay in advance (cash/
/// transfer verified, or bKash online) and only reach the kitchen once fully
/// paid. COD (cash on delivery) orders are collected at the door, so they do
/// not wait on prepayment — payment is recorded when the order is delivered.
enum PaymentMode {
  /// Pay before the order is confirmed (manual bKash/bank + claim, or wallet credit).
  PAY_FIRST
  /// Charged to the wallet at once, within the customer's credit limit.
  PAY_LATER
  /// Cash on delivery: charged and collected when delivered.
  COD
}

/// A customer's saved delivery address. Orders snapshot the address fields so
/// editing or deleting an address never changes past orders.
model Address {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label          String?
  recipientName  String
  recipientPhone String
  addressLine    String
  area           String?
  city           String
  note           String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
}

/// A customer order. Financial fields are captured at checkout and never
/// recomputed from current product prices (historical immutability). Delivery
/// discounts, payments, and actual delivery cost arrive in later phases.
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Null for guest orders placed without an account. Guest contact is captured
  // in the address snapshot below (recipientName/recipientPhone) plus the
  // optional guestEmail.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  /// Optional email for a guest order, used to invite them to register.
  guestEmail String?
  /// Footprint: the admin who placed this order on the customer's behalf (null
  /// when the customer or a guest ordered themselves).
  placedById String?
  placedBy   User?     @relation("OrderPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)

  // Delivery address snapshot.
  recipientName  String
  recipientPhone String
  addressLine    String
  area           String?
  city           String
  addressNote    String?

  /// The day the food is to be prepared/delivered (advance order).
  fulfillmentDate DateTime @db.Date
  /// Chosen two-hour delivery window for the fulfillment day, stored as a
  /// canonical "HH:MM-HH:MM" value (e.g. "12:00-14:00"). Nullable for orders
  /// placed before time slots existed.
  timeSlot        String?
  notes           String?

  /// Gross food total (sum of list prices × quantity).
  subtotal             Decimal @db.Decimal(10, 2)
  /// Food discount total (per-item sale reductions + any food coupon).
  productDiscount      Decimal @default(0) @db.Decimal(10, 2)
  customerDeliveryCost Decimal @db.Decimal(10, 2)
  /// Delivery discount (from a delivery coupon), kept separate from food.
  deliveryDiscount     Decimal @default(0) @db.Decimal(10, 2)
  /// Customer payable: (subtotal - productDiscount) + delivery - deliveryDiscount.
  total                Decimal @db.Decimal(10, 2)
  couponCode           String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  /// How this order is settled (see PaymentMode and the wallet node in vault/).
  paymentMode   PaymentMode   @default(PAY_FIRST)

  /// Kitchen marked the order packed and ready to dispatch (status stays PREPARING).
  readyAt                 DateTime?
  /// When the order went OUT_FOR_DELIVERY.
  dispatchedAt            DateTime?
  /// When the order reached DELIVERED (drives the day-after review invite).
  deliveredAt             DateTime?
  /// Secret, unguessable token for the public tracking link (/track/<token>)
  /// emailed when the order is confirmed. Lets anyone holding the link follow
  /// the order without logging in, e.g. a customer who hasn't registered yet.
  trackingToken           String?   @unique
  /// When the "order confirmed" email with the tracking link was sent, so it
  /// goes out only once even if the order is re-confirmed.
  confirmationEmailSentAt DateTime?
  /// When the "leave a review" invite (notification + email) was sent, so it
  /// is only sent once per order.
  reviewInviteSentAt      DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  delivery      Delivery?
  walletEntries WalletEntry[]
  reviews       Review[]

  @@index([customerId])
  @@index([status])
  @@index([fulfillmentDate])
  @@index([guestEmail])
}

/// A line in an order. Captures the product name and unit price at order time
/// so historical orders stay correct even if the product changes later.
model OrderItem {
  id            String           @id @default(cuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  /// Original list price at order time (before any sale price).
  listUnitPrice Decimal          @db.Decimal(10, 2)
  /// Charged unit price (sale price when the item was on sale).
  unitPrice     Decimal          @db.Decimal(10, 2)
  quantity      Int
  /// Charged line total (unitPrice × quantity).
  lineTotal     Decimal          @db.Decimal(10, 2)
  /// Kitchen preparation stage of this specific line (per-order, per-product).
  /// The order's overall status is derived from its lines.
  kitchenStage  KitchenLineStage @default(TO_COOK)

  @@index([orderId])
  @@index([productId])
}

/// A single order line's kitchen stage. The three stages mirror the kitchen
/// board columns; the order's status is derived from all its lines.
enum KitchenLineStage {
  TO_COOK
  PREPARING
  READY
}

enum CouponScope {
  FOOD
  DELIVERY
  /// Not a discount: raises the redeemer's pay-later limit by `value` for `limitDays` days.
  WALLET_LIMIT
}

enum CouponKind {
  PERCENT
  FIXED
  FREE_DELIVERY
}

/// A promotion code. FOOD coupons reduce the food total; DELIVERY coupons
/// reduce the delivery charge. Keeps food and delivery discounts separate.
model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  scope            CouponScope
  kind             CouponKind
  /// Percent (0-100) for PERCENT, fixed amount for FIXED, ignored for FREE_DELIVERY.
  value            Decimal            @default(0) @db.Decimal(10, 2)
  /// Minimum net food amount required to use the coupon.
  minOrderSubtotal Decimal            @default(0) @db.Decimal(10, 2)
  isActive         Boolean            @default(true)
  expiresAt        DateTime?
  /// WALLET_LIMIT only: how many days the raised limit lasts after redeeming.
  limitDays        Int?
  /// Optional cap on total redemptions (WALLET_LIMIT).
  maxRedemptions   Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  limitGrants      WalletLimitGrant[]
}

/// Single-row configuration for the advance-order rules. Admin-editable so the
/// cutoff and delivery charge are never hard-coded.
model OrderingSetting {
  id                  String   @id @default("singleton")
  /// Local cutoff time in HH:mm. After this, next-day ordering closes.
  cutoffTime          String   @default("22:00")
  /// Minimum days ahead an order must be placed (1 = order for tomorrow).
  minAdvanceDays      Int      @default(1)
  /// Default customer delivery charge applied at checkout.
  defaultDeliveryCost Decimal  @default(60) @db.Decimal(10, 2)
  timezone            String   @default("Asia/Dhaka")
  /// Default pay-later limit: how far below zero a wallet may go (BDT).
  walletCreditLimit   Decimal  @default(100) @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Phase 5 — Kitchen production
// -----------------------------------------------------------------------------
//
// The kitchen tracks preparation per ORDER (via Order.status: CONFIRMED →
// PREPARING → PACKED), like a Kitchen Display System — not per aggregated
// product. So a new order for the same item never inherits another order's
// prep/pack state. No dedicated table is needed.

// -----------------------------------------------------------------------------
// Phase 6 — Delivery
// -----------------------------------------------------------------------------

/// A delivery record for one order. There are exactly two cost values:
/// `customerDeliveryCost` (what the customer was charged, net of any delivery
/// discount) and `actualDeliveryCost` (what the business pays the third-party
/// provider, entered later). The difference is derived, never stored, and there
/// is deliberately NO estimated delivery cost.
model Delivery {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String?
  trackingRef          String?
  customerDeliveryCost Decimal  @db.Decimal(10, 2)
  actualDeliveryCost   Decimal? @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Phase 7 — Payments
// -----------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  CARD
  BANK
  ONLINE
}

/// Review state of a wallet entry. Only CONFIRMED entries count toward the balance.
enum WalletEntryStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// What a wallet entry is.
enum WalletEntryType {
  /// −total: an order charged to the wallet.
  ORDER_CHARGE
  /// +total: a charge reversed because the order was cancelled.
  ORDER_REFUND
  /// +amount: money the customer paid (claim, cash on delivery, admin-recorded).
  PAYMENT
  /// ±amount: an admin adjustment with a reference (corrections, cash paid back…).
  ADJUSTMENT
}

/// Who created the payment record. CUSTOMER rows start as PENDING claims that an
/// admin must verify before they count toward the order's paid total.
enum PaymentSource {
  ADMIN
  CUSTOMER
  /// Created automatically by the system (order charges and reversals).
  SYSTEM
}

/// Public payment-account details shown to customers for manual payments.
/// Singleton row (id = "singleton"); editable by admins in Business Profile.
model PaymentSetting {
  id        String   @id @default("singleton")
  bkash     String?
  nagad     String?
  rocket    String?
  bankInfo  String?
  updatedAt DateTime @updatedAt
}

/// Business identity/profile (name, logo, contact, address, partners, defaults).
/// Stored as a JSON blob in a singleton row so the whole profile persists and is
/// shared across all clients; editable by admins in Business Profile settings.
model BusinessProfileSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

/// A single payment transaction against an order. Kept separate from the order
/// (not a full ledger) so gateway integration can be added later. The order's
/// paymentStatus is recomputed from these rows. Refunds are recorded as a row
/// with status REFUNDED and a positive amount.
/// One entry in a customer's wallet: the platform-wide ledger of what they owe
/// and have paid. Amounts are signed (+ credits the wallet, − debits it); the
/// balance is the sum of CONFIRMED entries. Entries are never deleted or edited
/// after review: corrections are new ADJUSTMENT entries, so the timeline is a
/// complete audit trail. customerId is null only for guest orders (no account);
/// those rows move to the account if the guest later signs in with that email.
model WalletEntry {
  id         String            @id @default(cuid())
  customerId String?
  customer   Customer?         @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type       WalletEntryType
  status     WalletEntryStatus @default(CONFIRMED)
  amount     Decimal           @db.Decimal(10, 2)
  method     PaymentMethod?
  /// Proof: the bKash/Nagad trx id, bank ref, or an admin reference.
  reference  String?
  note       String?
  source     PaymentSource
  createdAt  DateTime          @default(now())

  // Audit trail (name snapshots stay correct if the user is renamed or removed).
  createdById    String?
  createdByName  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedByName String?
  /// Why a claim was rejected.
  reviewNote     String?

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([status])
}

/// A temporary raise of a customer's pay-later limit, from redeeming a
/// WALLET_LIMIT promo code. Active while expiresAt is in the future.
model WalletLimitGrant {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  code       String
  amount     Decimal  @db.Decimal(10, 2)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([customerId, couponId])
  @@index([customerId, expiresAt])
}

// -----------------------------------------------------------------------------
// Phase 8 — Inventory & costing
// -----------------------------------------------------------------------------

enum MaterialKind {
  INGREDIENT
  PACKAGING
}

/// A raw ingredient or packaging item. Stock quantity and a weighted-average
/// unit cost are maintained from purchases (no FIFO/LIFO). `unit` is free text
/// (kg, L, g, pcs); purchase and recipe quantities are in this unit.
model Material {
  id          String       @id @default(cuid())
  name        String       @unique
  kind        MaterialKind
  unit        String
  stockQty    Decimal      @default(0) @db.Decimal(12, 3)
  avgUnitCost Decimal      @default(0) @db.Decimal(12, 4)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  purchaseItems PurchaseItem[]
  recipeItems   RecipeItem[]
  inventoryTxns InventoryTransaction[]
}

/// A purchase (bulk buy). Its items update inventory and average cost.
model Purchase {
  id          String         @id @default(cuid())
  purchasedAt DateTime       @default(now())
  supplier    String?
  note        String?
  totalCost   Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(12, 3)
  totalCost  Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([materialId])
}

enum InventoryTxnType {
  PURCHASE
  ADJUSTMENT
}

/// Append-only log of stock movements for auditing.
model InventoryTransaction {
  id            String           @id @default(cuid())
  materialId    String
  material      Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type          InventoryTxnType
  quantityDelta Decimal          @db.Decimal(12, 3)
  unitCost      Decimal          @db.Decimal(12, 4)
  note          String?
  createdAt     DateTime         @default(now())

  @@index([materialId])
}

/// A product's recipe / bill of materials. `yieldQty` is how many sellable
/// units one batch produces; cost per unit is derived from the items'
/// materials' average costs divided by the yield.
model Recipe {
  id        String       @id @default(cuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  yieldQty  Int
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     RecipeItem[]
}

model RecipeItem {
  id         String   @id @default(cuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(12, 3)

  @@index([recipeId])
  @@index([materialId])
}

// -----------------------------------------------------------------------------
// Phase 9 — Expenses & profit
// -----------------------------------------------------------------------------

/// A general business expense category (e.g. Gas, Marketing). Dynamic so the
/// owner can add categories without code changes.
model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

/// A general business expense. Ingredient/packaging purchases are NOT recorded
/// here — those update inventory (Phase 8). Kept simple: no accounting ledger.
model Expense {
  id          String          @id @default(cuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal         @db.Decimal(12, 2)
  spentAt     DateTime        @db.Date
  description String
  note        String?
  createdAt   DateTime        @default(now())

  @@index([spentAt])
  @@index([categoryId])
}

// -----------------------------------------------------------------------------
// Phase 11 — Automation (notifications)
// -----------------------------------------------------------------------------

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_PACKED
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  /// Order returned to pending because a payment was refunded/voided and it is
  /// no longer fully paid.
  ORDER_PENDING
  PAYMENT_RECEIVED
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYMENT_REFUNDED
  NEW_ORDER
  REVIEW_INVITE
}

/// A browser Web Push subscription for a user's device. One row per device/
/// browser (keyed by its unique endpoint). Used to deliver OS-level push
/// notifications alongside the in-app ones. Pruned when the endpoint expires.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// An in-app notification for a user. Generated from order/payment events.
/// Email/SMS/push channels can be layered on top later.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// Structured payload for client-side localization: a message key plus its
  /// parameters (order number, amount, method…). The stored title/body are the
  /// Bengali fallback used when a client can't localize from `data`.
  data      Json?
  orderId   String?
  /// In-app path to open when the notification is clicked (e.g. an order or the
  /// order's review page). Null for notifications with no destination.
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// -----------------------------------------------------------------------------
// Phase 12 — Product reviews & ratings
// -----------------------------------------------------------------------------

/// A customer's star rating (1-5) and optional written feedback, tied to a
/// specific delivered order. Reviews can only be created from that order's
/// review page. `productId` set = a review of one product in the order;
/// `productId` null = the overall order/experience review. At most one product
/// review per (order, product) and one overall review per order (the latter
/// enforced by a partial unique index added in the migration).
model Review {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Whole-star rating from 1 to 5.
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([orderId, productId])
  @@index([productId])
  @@index([rating])
  @@index([orderId])
}
