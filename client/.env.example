# Base URL of the backend API (include the /api suffix).
# Local dev default (used if unset): http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# Google Sign-In client ID (same as GOOGLE_CLIENT_ID on the server). Sign-in is
# Google only, so without it nobody can sign in (guest checkout still works).
VITE_GOOGLE_CLIENT_ID=
